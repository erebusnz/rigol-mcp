# USB transport (preferred when set). Set RIGOL_USB to a truthy value to connect
# over USB instead of LAN. The first Rigol USB scope is auto-discovered.
RIGOL_USB=1

# Optional: pin a specific scope by serial number when several are connected.
#RIGOL_USB_SERIAL=DS1ZA000000000

# Optional: open this exact USB VISA address instead of discovering devices.
# Requires RIGOL_USB=1 and takes precedence over RIGOL_USB_SERIAL.
#RIGOL_USB_RESOURCE=USB0::0x1AB1::0x04CE::DS1ZA000000000::INSTR

# Optional: skip VISA device clear on USB if it hangs during connection or recovery.
#RIGOL_USB_SKIP_CLEAR=1

# LAN transport
RIGOL_IP=192.168.1.123

# Enable the send_raw tool (arbitrary SCPI). Off by default — only the dedicated
# tools are exposed unless this is set.
#RIGOL_ENABLE_SEND_RAW=1

# Optional: serve MCP over HTTP. These configure the SERVER, not the client.
# Set a generated token before exposing a non-loopback address.
# See docs/remote-operation.md for client URL/authentication setup.
#RIGOL_MCP_TRANSPORT=http
#RIGOL_MCP_HOST=0.0.0.0
#RIGOL_MCP_PORT=8000
#RIGOL_MCP_TOKEN=

# Optional: enable HTTPS on the same port. Supply both files; keep transport=http.
# Paths are relative to the server's working directory. Clients must trust the CA.
#RIGOL_MCP_SSL_CERTFILE=certs/server.pem
#RIGOL_MCP_SSL_KEYFILE=certs/server-key.pem
